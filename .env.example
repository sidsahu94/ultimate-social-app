# ====================================================================
# ULTIMATE SOCIAL / VESPERA - ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================

PORT=5000
NODE_ENV=development

# Application Gateway & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000
VITE_API_URL=/api

# Persistence & Data Tier
# Local MongoDB: mongodb://127.0.0.1:27017/ultimate_social
# Docker Replica Set: mongodb://mongo:27017/ultimate_social?replicaSet=rs0
MONGO_URI=mongodb://127.0.0.1:27017/ultimate_social
REDIS_URL=redis://localhost:6379

# Cryptographic Token Authentication Keys (Generate 64+ char random hex keys)
JWT_SECRET=your_jwt_secret_key_minimum_64_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_64_characters_here
VITE_ENCRYPTION_KEY=your_client_side_aes_encryption_key_here

# Third-Party Integrations
NEWSDATA_API_KEY=your_newsdata_api_key_here
GOLD_API_KEY=your_goldapi_key_here
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
RESEND_API_KEY=your_resend_api_key_here

# Cloudinary Media Storage (Optional: Local disk fallback in /uploads active if unset)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Real-Time Telemetry & Web Push
METERED_DOMAIN=your_domain.metered.live
METERED_API_KEY=your_metered_api_key
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:admin@example.com

# SMTP Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
EMAIL_FROM=admin@vespera.com
